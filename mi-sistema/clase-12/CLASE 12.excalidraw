      "width": 354.9,
      "height": 178.75,
      "fontSize": 11,
      "fontFamily": 3,
      "text": "const listaUsuarios = [\"Erick\", \"Mhitzy\", \"Gefferson\"];\n\ntry {\n  const usuario = listaUsuarios.find(\n    u => u === \"Erick\"\n  );\n  if (!usuario) {\n    throw new Error(\"No existe\");   // <- forzar throw\n  }\n  console.log(\"Encontrado:\", usuario);\n} catch (error) {\n  console.log(\"No existe, mostrar registro.\");\n}",
      "originalText": "const listaUsuarios = [\"Erick\", \"Mhitzy\", \"Gefferson\"];\n\ntry {\n  const usuario = listaUsuarios.find(\n    u => u === \"Erick\"\n  );\n  if (!usuario) {\n    throw new Error(\"No existe\");   // <- forzar throw\n  }\n  console.log(\"Encontrado:\", usuario);\n} catch (error) {\n  console.log(\"No existe, mostrar registro.\");\n}",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 9
